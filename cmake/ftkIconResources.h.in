#pragma once

#include <cstdint>
#include <map>
#include <string>
#include <vector>

namespace @ICON_NAMESPACE@
{
    //! The icons compiled into the library, keyed by name. Generated
    //! by ftk_icon_resources() from a directory of files, so adding an
    //! icon is adding a file there.
    const std::map<std::string, std::vector<uint8_t>*>& getIconResources();
}
