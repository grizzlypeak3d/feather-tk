+/* The output a window made fullscreen on a given display before it is shown
+ * asks for before its initial commit, or NULL. Asked for then, the first
+ * configure is already fullscreen on that output. Asked for after, as the
+ * pending flags are applied once shown, the first buffer acks a floating
+ * configure, and a compositor that places new floating windows (mutter, on
+ * the monitor with the pointer) maps it there and keeps it there.
+ */
+static struct wl_output *GetInitialFullscreenOutput(SDL_Window *window)
+{
+    if ((window->pending_flags & SDL_WINDOW_FULLSCREEN) && window->requested_fullscreen_mode.displayID) {
+        SDL_VideoDisplay *display = SDL_GetVideoDisplay(window->requested_fullscreen_mode.displayID);
+        if (display && display->internal) {
+            return display->internal->output;
+        }
+    }
+    return NULL;
+}
