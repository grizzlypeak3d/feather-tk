--- a/src/video/cocoa/SDL_cocoakeyboard.m
+++ b/src/video/cocoa/SDL_cocoakeyboard.m
@@ -287,6 +287,25 @@ static void HandleModifiers(SDL_VideoDevice *_this, SDL_Scancode code, unsigned
     }
 }
 
+/* A Shift held down while another application was in front was pressed
+   there, so the press never came here, and a Shift+drag that is the
+   window's first click would be a plain drag. A mouse event carries the
+   modifiers as they are, whichever window had them. The release comes
+   here as a change of flags, the window being in front by then. */
+void Cocoa_SyncShift(NSEvent *event)
+{
+    const unsigned int flags = (unsigned int)[event modifierFlags];
+    const bool *keystate = SDL_GetKeyboardState(NULL);
+    if (!keystate[SDL_SCANCODE_LSHIFT] &&
+        IsModifierKeyPressed(flags, NX_DEVICELSHIFTKEYMASK, NX_DEVICERSHIFTKEYMASK, NX_SHIFTMASK)) {
+        SDL_SendKeyboardKey(0, SDL_DEFAULT_KEYBOARD_ID, 0, SDL_SCANCODE_LSHIFT, true);
+    }
+    if (!keystate[SDL_SCANCODE_RSHIFT] &&
+        IsModifierKeyPressed(flags, NX_DEVICERSHIFTKEYMASK, NX_DEVICELSHIFTKEYMASK, NX_SHIFTMASK)) {
+        SDL_SendKeyboardKey(0, SDL_DEFAULT_KEYBOARD_ID, 0, SDL_SCANCODE_RSHIFT, true);
+    }
+}
