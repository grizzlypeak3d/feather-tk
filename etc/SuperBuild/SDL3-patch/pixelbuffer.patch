+            plane = (createinfo->format == SDL_GPU_TEXTUREFORMAT_R8G8_UNORM) ? 1 : 0;
+            break;
+        case kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange:
+        case kCVPixelFormatType_420YpCbCr10BiPlanarFullRange:
+            plane = (createinfo->format == SDL_GPU_TEXTUREFORMAT_R16G16_UNORM) ? 1 : 0;
+            break;
+        default:
+            break;
+        }
+    }
 
