+#ifndef SDL_PLATFORM_VISIONOS
+/* The display of a screen. */
+static SDL_VideoDisplay *UIKit_GetDisplayForScreen(SDL_VideoDevice *_this, UIScreen *uiscreen)
+{
+    for (int i = 0; i < _this->num_displays; ++i) {
+        SDL_VideoDisplay *display = _this->displays[i];
+        SDL_UIKitDisplayData *displaydata = (__bridge SDL_UIKitDisplayData *)display->internal;
+        if (displaydata && displaydata.uiscreen == uiscreen) {
+            return display;
+        }
+    }
+    return NULL;
+}
+
+/* A window is on the display of its screen, wherever its position would
+   put it: the displays are only laid out left to right, and a window's
+   position on them depends on the device's orientation. */
+SDL_DisplayID UIKit_GetDisplayForWindow(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    @autoreleasepool {
+        if (window->internal) {
+            SDL_UIKitWindowData *data = (__bridge SDL_UIKitWindowData *)window->internal;
+            UIScreen *uiscreen = data.uiwindow.screen;
+            if (@available(iOS 13.0, tvOS 13.0, *)) {
+                if (data.uiwindow.windowScene) {
+                    uiscreen = data.uiwindow.windowScene.screen;
+                }
+            }
+            SDL_VideoDisplay *display = UIKit_GetDisplayForScreen(_this, uiscreen);
+            if (display) {
+                return display->id;
+            }
+        }
+        return 0;
+    }
+}
+#endif
