<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>@ftk_WEB_APP@</title>
<style>
html, body {
    margin: 0;
    height: 100%;
    overflow: hidden;
    background: #181818;
    /* Dragging in the canvas is the application's own selection, not
       the page's. */
    user-select: none;
    -webkit-user-select: none;
}
canvas { display: block; width: 100%; height: 100%; -webkit-user-drag: none; }
/* Errors are shown on the page: on a phone or a tablet there is no
   console to read, and the alternative is a silent black page. */
#error {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    max-height: 50%;
    overflow: auto;
    margin: 0;
    padding: 1em;
    background: #401818;
    color: #f0d0d0;
    font: 12px monospace;
    white-space: pre-wrap;
    user-select: text;
    -webkit-user-select: text;
}
</style>
</head>
<body>
<canvas id="canvas" oncontextmenu="event.preventDefault()"></canvas>
<pre id="error"></pre>
<script>
function ftkError(text) {
    var el = document.getElementById('error');
    el.style.display = 'block';
    el.textContent += text + '\n';
}
window.onerror = function(message, source, line, column, error) {
    ftkError(message +
        (error && error.stack ? '\n' + error.stack : ''));
};
window.onunhandledrejection = function(event) {
    ftkError(String(event.reason));
};
var Module = {
    canvas: document.getElementById('canvas'),
    print: function(text) {
        console.log(text);
        if (/^(ERROR:|Unhandled exception)/.test(text)) {
            ftkError(text);
        }
    },
    printErr: function(text) {
        console.error(text);
        ftkError(text);
    },
    onAbort: function(what) {
        ftkError('Aborted: ' + what);
    },
    /* The build id keeps the page and its binary together: a cached
       page fetches the .js and .wasm it was built with, not whatever a
       newer deployment left behind. */
    locateFile: function(path) {
        return path + '?v=@ftk_WEB_ID@';
    },
    /* The query string is the command line: "?page=Dialogs" becomes
       "-page Dialogs". */
    arguments: (function() {
        var out = [];
        new URLSearchParams(location.search).forEach(function(value, key) {
            out.push('-' + key);
            if (value)
            {
                out.push(value);
            }
        });
        return out;
    })()
};
</script>
<script src="@ftk_WEB_APP@.js?v=@ftk_WEB_ID@"></script>
</body>
</html>
