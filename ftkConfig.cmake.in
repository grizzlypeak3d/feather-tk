@PACKAGE_INIT@

# \todo Is this the correct way to locate the custom Find*.cmake files?
list(APPEND CMAKE_MODULE_PATH ${CMAKE_CURRENT_LIST_DIR})

# The dependencies are installed with feather-tk, by the super build and in a
# wheel, so they are looked for here first. This file runs in the caller's
# scope, so the search path is put back afterwards.
set(_ftk_PREFIX_PATH ${CMAKE_PREFIX_PATH})
list(PREPEND CMAKE_PREFIX_PATH "${PACKAGE_PREFIX_DIR}")

include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(ZLIB)
find_dependency(nlohmann_json)
find_dependency(PNG)
find_dependency(Freetype)
find_dependency(lunasvg)

# On the web, SDL and GL come from Emscripten itself rather than from
# packages; see the main CMakeLists.
if(NOT EMSCRIPTEN)
    if(@ftk_API@ STREQUAL "GL_4_1" OR
        @ftk_API@ STREQUAL "GL_4_1_Debug" OR
        @ftk_API@ STREQUAL "GLES_3")
        find_dependency(OpenGL)
    endif()

    if(@ftk_SDL2@)
        find_dependency(SDL2)
    elseif(@ftk_SDL3@)
        find_dependency(SDL3)
    endif()
endif()

if(@ftk_nfd@)
    find_dependency(nfd)
endif()

# The bindings are linked into the feather_tk module and nothing else, so a
# consumer needs neither Python nor nanobind to use this package.

set(CMAKE_PREFIX_PATH ${_ftk_PREFIX_PATH})
unset(_ftk_PREFIX_PATH)

include("${CMAKE_CURRENT_LIST_DIR}/ftkEmbedText.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/ftkIconResources.cmake")
# The ftk-resource tool is only installed when feather-tk is the top
# level project; a cross-compiling consumer names a native one with
# ftk_RESOURCE instead.
include("${CMAKE_CURRENT_LIST_DIR}/ftk-resourceTargets.cmake" OPTIONAL)
include("${CMAKE_CURRENT_LIST_DIR}/ftkResourceTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/ftkCoreTargets.cmake")
if(@ftk_API@ STREQUAL "GL_4_1" OR
    @ftk_API@ STREQUAL "GL_4_1_Debug" OR
    @ftk_API@ STREQUAL "GLES_3")
    include("${CMAKE_CURRENT_LIST_DIR}/ftkGLTargets.cmake")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/ftkUITargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/ftkTestLibTargets.cmake")

# \todo Is this the correct way to add the include directory?
include_directories("@PACKAGE_INCLUDE_INSTALL_DIR@")

check_required_components(ftk)
